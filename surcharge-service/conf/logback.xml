<configuration>
  <import class="ch.qos.logback.classic.AsyncAppender"/>
  <import class="ch.qos.logback.classic.encoder.PatternLayoutEncoder"/>
  <import class="ch.qos.logback.core.ConsoleAppender"/>

  <appender name="STDOUT" class="ConsoleAppender">
    <encoder class="PatternLayoutEncoder">
      <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) %cyan(%logger{36}) - %msg%n%xException{10}</pattern>
    </encoder>
  </appender>

  <!-- Request threads only queue the event; one background thread writes to the console, so a
       slow or blocked stdout never stalls a request. The trade-off is that logs can be lost under
       extreme load: once the queue is 80% full INFO and below are dropped, and when it's full
       neverBlock drops every level rather than wait. 8192 events is about 0.5-0.65 s of quote log
       lines at the measured two-generator peak (about 12,000-16,000/s). Caller data stays off: it
       is costly and the pattern doesn't use it. -->
  <appender name="ASYNC" class="AsyncAppender">
    <queueSize>8192</queueSize>
    <neverBlock>true</neverBlock>
    <appender-ref ref="STDOUT"/>
  </appender>

  <logger name="play" level="INFO"/>
  <logger name="application" level="INFO"/>
  <logger name="services" level="INFO"/>
  <logger name="controllers" level="INFO"/>

  <root level="WARN">
    <appender-ref ref="ASYNC"/>
  </root>
</configuration>
